# Copy to .env and edit. The experiment scripts and reproduce.sh read these; the library does not.

# folder with the Cboe chains SPX_YYYYMMDD_HHMM.json
DATA_DIR=./data
# where experiments write their outputs
RESULTS_DIR=./results
# threads for numpy / scipy linear algebra (the solver is small and serial, so 1-4 is plenty)
OMP_NUM_THREADS=2
